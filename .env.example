# DISCORD

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# HOTMART
# Shared secret Hotmart sends in the X-HOTMART-HOTTOK header of every delivery.
HOTMART_WEBHOOK_SECRET=

# HTTP
PORT=3333

# Reconciliation sweep that realigns Discord roles with the database.
RECONCILE_INTERVAL_MINUTES=15

# Database
DATABASE_URL="postgresql://docker:docker@localhost:5432/agents"
