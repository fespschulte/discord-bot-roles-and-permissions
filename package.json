{
  "name": "bot-discord",
  "version": "1.0.0",
  "description": "Bot Discord integrado ao Hotmart para gerenciamento de assinaturas.",
  "main": "src/index.ts",
  "scripts": {
    "start": "ts-node -r dotenv/config src/index.ts",
    "dev": "node --watch -r dotenv/config -r ts-node/register src/index.ts",
    "reconcile": "ts-node -r dotenv/config src/scripts/reconcile.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "ts-node -r dotenv/config src/db/seed.ts"
  },
  "dependencies": {
    "discord.js": "^14.14.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.3",
    "fastify": "^5.4.0",
    "fastify-type-provider-zod": "^5.0.2",
    "postgres": "^3.4.7",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.5",
    "@types/node": "^20.11.30",
    "drizzle-kit": "^0.31.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "ultracite": "^5.0.36",
    "vitest": "^3.2.4"
  }
}
