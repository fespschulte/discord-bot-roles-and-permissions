{
  "name": "bot-discord",
  "version": "1.0.0",
  "description": "Bot Discord integrado ao Hotmart para gerenciamento de assinaturas.",
  "main": "src/index.js",
  "scripts": {
    "start": "ts-node -r dotenv/config src/index.ts",
    "dev": "ts-node -r dotenv/config --watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "ts-node -r dotenv/config src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "discord.js": "^14.14.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.3",
    "fastify": "^5.4.0",
    "fastify-type-provider-zod": "^5.0.2",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.4",
    "drizzle-seed": "^0.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.4.5",
    "ultracite": "^5.0.36"
  }
}
